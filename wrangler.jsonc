// Cloudflare deploy settings. On every push to main, Cloudflare runs `npx wrangler deploy`, which uploads
// the site/ folder as static files. There is no build step and no server code.
{
  // Must match the project name in the Cloudflare dashboard, or the deploy fails.
  "name": "setmaat",
  "compatibility_date": "2025-12-01",
  "assets": {
    "directory": "./site",
    // Unknown paths get site/404.html with a 404 status, so search engines don't index them as pages.
    "not_found_handling": "404-page"
  }
}
